# Copy to apps/api/.env and apps/web/.env.local

# PostgreSQL
DATABASE_URL="postgresql://kgs:kgs_dev@localhost:5432/kaizentrix_exam?schema=public"

# NestJS
API_PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
